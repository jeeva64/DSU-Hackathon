# ============================================
# NelSync AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in values.
# Do NOT commit .env to version control.

# ---- Database ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/nelsync_ai

# ---- Application ----
APP_ENV=development
APP_NAME=NelSync AI
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ---- CORS ----
# Comma-separated origins allowed to access the API
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ---- LLM (Optional) ----
# The application works fully without these keys.
# LLM is only used for optional natural-language explanations.
LLM_API_KEY=
LLM_PROVIDER=

# ---- Server ----
HOST=0.0.0.0
PORT=8000
